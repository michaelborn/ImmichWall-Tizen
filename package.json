{
  "name": "immich-wall-poc",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop proof of concept for an Immich photo frame",
  "scripts": {
    "start": "node scripts/desktop-server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:e2e": "playwright test --config=test/playwright.config.mjs",
    "test:live": "node --test test/live/*.test.mjs",
    "test:all": "npm run check && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@xmldom/xmldom": "^0.9.12"
  }
}
