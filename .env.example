# Copy to .env and configure this installation. Keep the real values out of the repo.
TV_IP=
TV_NAME=

# Public HTTPS hostnames used to build the TV pairing screen and set the default Immich URL.
PAIRING_BASE_URL=
IMMICH_SERVER_URL=

# Optional read-only key for explicit live API tests. The desktop service does not load it by default.
IMMICH_API_KEY=
