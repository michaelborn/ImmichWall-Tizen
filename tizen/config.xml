<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://immich.app/tv"
        version="0.1.0"
        viewmodes="fullscreen">
    <access origin="*" />
    <access origin="https://immichwall.theborns.xyz" />
    <tizen:application id="ImTvWall01.ImmichWall" package="ImTvWall01" required_version="2.4" />
    <content src="index.html" />
    <icon src="icon.png" />
    <description>Full-screen Immich photo slideshow</description>
    <feature name="http://tizen.org/feature/screen.size.all" />
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
    <name>Immich Wall</name>
    <tizen:profile name="tv" />
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="fullscreen" />
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable" />
</widget>
